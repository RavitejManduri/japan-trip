<Style id="d6"><IconStyle><color>fff4d442</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LineStyle><color>fff4d442</color><width>4</width></LineStyle></Style>
<Style id="d7"><IconStyle><color>ffe632f0</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LineStyle><color>ffe632f0</color><width>4</width></LineStyle></Style>
<Style id="d8"><IconStyle><color>ff45efbf</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LineStyle><color>ff45efbf</color><width>4</width></LineStyle></Style>
<Style id="d9"><IconStyle><color>ff000080</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LineStyle><color>ff000080</color><width>4</width></LineStyle></Style>
<Folder><name>Day 1 - Wed 25 Nov - Arrive Osaka</name>
<Placemark><name>D1.1 Kansai Airport (KIX)</name><description><![CDATA[Land 15:10 on CX506 (HYD 02:05 -> HKG 09:55, 50 min connection -> KIX 15:10). Private car transfer to hotel. Included.<br><a href="https://www.google.com/maps/search/?api=1&query=Kansai%20International%20Airport">Open in Google Maps</a>]]></description><styleUrl>#d1</styleUrl><Point><coordinates>135.2304,34.432,0</coordinates></Point></Placemark>
<Placemark><name>D1.2 S Presso Namba Parks Street (hotel, 4 nights)</name><description><![CDATA[3-star, Standard Apartment, breakfast (CP). Check-in 25 Nov, check-out 29 Nov. Pin is approximate (Namba Parks area); the PDF gives no address.<br><a href="https://www.google.com/maps/search/?api=1&query=S%20Presso%20Namba%20Parks%20Street%20Osaka">Open in Google Maps</a>]]></description><styleUrl>#d1</styleUrl><Point><coordinates>135.502,34.6617,0</coordinates></Point></Placemark>
<Placemark><name>D1 route</name><styleUrl>#d1</styleUrl><LineString><tessellate>1</tessellate><coordinates>135.2304,34.432,0 135.502,34.6617,0</coordinates></LineString></Placemark>
</Folder>
<Folder><name>Day 2 - Thu 26 Nov - Osaka City Pass</name>
<Placemark><name>D2.1 Osaka City Pass (Loop Bus, Metro, City Bus)</name><description><![CDATA[1-day unlimited Wonder Loop Bus + Osaka Metro + City Bus, English-speaking guide. The PDF names no specific stops; Osaka Castle is pinned as the main loop-bus stop. Meals not included.<br><a href="https://www.google.com/maps/search/?api=1&query=Osaka%20Castle">Open in Google Maps</a>]]></description><styleUrl>#d2</styleUrl><Point><coordinates>135.5262,34.6873,0</coordinates></Point></Placemark>
<Placemark><name>D2.2 Osaka Wonder Cruise</name><description><![CDATA[Boarding ticket included with the pass. Pin is approximate (Dotonbori river area); check the pier on the ticket.<br><a href="https://www.google.com/maps/search/?api=1&query=Osaka%20Wonder%20Cruise">Open in Google Maps</a>]]></description><styleUrl>#d2</styleUrl><Point><coordinates>135.506,34.6688,0</coordinates></Point></Placemark>
<Placemark><name>D2 route</name><styleUrl>#d2</styleUrl><LineString><tessellate>1</tessellate><coordinates>135.5262,34.6873,0 135.506,34.6688,0</coordinates></LineString></Placemark>
</Folder>
<Folder><name>Day 3 - Fri 27 Nov - Kyoto &amp; Nara day tour</name>
<Placemark><name>D3.1 Fushimi Inari Taisha</name><description><![CDATA[Coach tour with English guide, hotel pickup/drop, tolls, parking and fuel included. Stop 1.<br><a href="https://www.google.com/maps/search/?api=1&query=Fushimi%20Inari%20Taisha">Open in Google Maps</a>]]></description><styleUrl>#d3</styleUrl><Point><coordinates>135.7727,34.9671,0</coordinates></Point></Placemark>
<Placemark><name>D3.2 Kinkaku-ji (Golden Pavilion)</name><description><![CDATA[Stop 2.<br><a href="https://www.google.com/maps/search/?api=1&query=Kinkaku-ji">Open in Google Maps</a>]]></description><styleUrl>#d3</styleUrl><Point><coordinates>135.7292,35.0394,0</coordinates></Point></Placemark>
<Placemark><name>D3.3 Nara Park</name><description><![CDATA[Stop 3. Free-roaming deer.<br><a href="https://www.google.com/maps/search/?api=1&query=Nara%20Park">Open in Google Maps</a>]]></description><styleUrl>#d3</styleUrl><Point><coordinates>135.843,34.6851,0</coordinates></Point></Placemark>
<Placemark><name>D3.4 Todai-ji (Great Buddha)</name><description><![CDATA[Stop 4. Then back to the Osaka hotel.<br><a href="https://www.google.com/maps/search/?api=1&query=Todai-ji">Open in Google Maps</a>]]></description><styleUrl>#d3</styleUrl><Point><coordinates>135.8398,34.689,0</coordinates></Point></Placemark>
<Placemark><name>D3 route</name><styleUrl>#d3</styleUrl><LineString><tessellate>1</tessellate><coordinates>135.7727,34.9671,0 135.7292,35.0394,0 135.843,34.6851,0 135.8398,34.689,0</coordinates></LineString></Placemark>
</Folder>
<Folder><name>Day 4 - Sat 28 Nov - Amanohashidate day tour</name>
<Placemark><name>D4.1 Chion-ji Temple</name><description><![CDATA[Pickup from a designated meeting point (not the hotel). English/Chinese guide.<br><a href="https://www.google.com/maps/search/?api=1&query=Chion-ji%20Amanohashidate">Open in Google Maps</a>]]></description><styleUrl>#d4</styleUrl><Point><coordinates>135.1907,35.5579,0</coordinates></Point></Placemark>
<Placemark><name>D4.2 Amanohashidate + bay cruise</name><description><![CDATA[One of Japan's Three Scenic Views. Cruise included.<br><a href="https://www.google.com/maps/search/?api=1&query=Amanohashidate">Open in Google Maps</a>]]></description><styleUrl>#d4</styleUrl><Point><coordinates>135.1925,35.57,0</coordinates></Point></Placemark>
<Placemark><name>D4.3 Kasamatsu Park (cable car viewpoint)</name><description><![CDATA[Cable car to the top for the 'Bridge to Heaven' view.<br><a href="https://www.google.com/maps/search/?api=1&query=Kasamatsu%20Park">Open in Google Maps</a>]]></description><styleUrl>#d4</styleUrl><Point><coordinates>135.1965,35.5869,0</coordinates></Point></Placemark>
<Placemark><name>D4.4 Miyama Kayabuki no Sato</name><description><![CDATA[Thatched-roof village. Return to Kyoto or Osaka in the evening.<br><a href="https://www.google.com/maps/search/?api=1&query=Miyama%20Kayabuki%20no%20Sato">Open in Google Maps</a>]]></description><styleUrl>#d4</styleUrl><Point><coordinates>135.5399,35.2775,0</coordinates></Point></Placemark>
<Placemark><name>D4 route</name><styleUrl>#d4</styleUrl><LineString><tessellate>1</tessellate><coordinates>135.1907,35.5579,0 135.1925,35.57,0 135.1965,35.5869,0 135.5399,35.2775,0</coordinates></LineString></Placemark>
</Folder>
<Folder><name>Day 5 - Sun 29 Nov - Osaka to Tokyo</name>
<Placemark><name>D5.1 Shin-Osaka Station</name><description><![CDATA[NOT IN THE PACKAGE: no Osaka -> Tokyo travel is included. Bullet train ~2.5 h, about Rs 18,000 for two (you pay).<br><a href="https://www.google.com/maps/search/?api=1&query=Shin-Osaka%20Station">Open in Google Maps</a>]]></description><styleUrl>#d5</styleUrl><Point><coordinates>135.5003,34.7335,0</coordinates></Point></Placemark>
<Placemark><name>D5.2 Comfort Hotel Tokyo Higashi Nihombashi (hotel, 4 nights)</name><description><![CDATA[3-star, Double Economy, 1 double bed, breakfast (CP). Check-in 29 Nov, check-out 3 Dec.<br><a href="https://www.google.com/maps/search/?api=1&query=Comfort%20Hotel%20Tokyo%20Higashi%20Nihombashi">Open in Google Maps</a>]]></description><styleUrl>#d5</styleUrl><Point><coordinates>139.7841,35.6922,0</coordinates></Point></Placemark>
<Placemark><name>D5.3 Shibuya Sky</name><description><![CDATA[Admission ticket only (no guide/transfer). 229 m open-air deck.<br><a href="https://www.google.com/maps/search/?api=1&query=Shibuya%20Sky">Open in Google Maps</a>]]></description><styleUrl>#d5</styleUrl><Point><coordinates>139.7022,35.6585,0</coordinates></Point></Placemark>
<Placemark><name>D5.4 Sumo Live Show with Photo, Shinjuku</name><description><![CDATA[Show with photo and water; chance to challenge a wrestler. Pin is approximate (Kabukicho); venue on the ticket.<br><a href="https://www.google.com/maps/search/?api=1&query=Sumo%20show%20Shinjuku%20Kabukicho">Open in Google Maps</a>]]></description><styleUrl>#d5</styleUrl><Point><coordinates>139.703,35.6946,0</coordinates></Point></Placemark>
<Placemark><name>D5 route</name><styleUrl>#d5</styleUrl><LineString><tessellate>1</tessellate><coordinates>135.5003,34.7335,0 139.7841,35.6922,0 139.7022,35.6585,0 139.703,35.6946,0</coordinates></LineString></Placemark>
</Folder>
<Folder><name>Day 6 - Mon 30 Nov - Hop-on hop-off + teamLab</name>
<Placemark><name>D6.1 Hop-on hop-off bus: Asakusa</name><description><![CDATA[Sky Hop Bus, unlimited rides, audio guide (bring earphones). Asakusa is on the Skytree course.<br><a href="https://www.google.com/maps/search/?api=1&query=Senso-ji">Open in Google Maps</a>]]></description><styleUrl>#d6</styleUrl><Point><coordinates>139.7967,35.7148,0</coordinates></Point></Placemark>
<Placemark><name>D6.2 Hop-on hop-off bus: Tokyo Skytree</name><description><![CDATA[Listed in the PDF as a highlight (bus passes by; tower entry not included).<br><a href="https://www.google.com/maps/search/?api=1&query=Tokyo%20Skytree">Open in Google Maps</a>]]></description><styleUrl>#d6</styleUrl><Point><coordinates>139.8107,35.7101,0</coordinates></Point></Placemark>
<Placemark><name>D6.3 Hop-on hop-off bus: Ginza</name><description><![CDATA[Listed highlight.<br><a href="https://www.google.com/maps/search/?api=1&query=Ginza">Open in Google Maps</a>]]></description><styleUrl>#d6</styleUrl><Point><coordinates>139.765,35.6717,0</coordinates></Point></Placemark>
<Placemark><name>D6.4 Hop-on hop-off bus: Tsukiji</name><description><![CDATA[Listed highlight.<br><a href="https://www.google.com/maps/search/?api=1&query=Tsukiji%20Outer%20Market">Open in Google Maps</a>]]></description><styleUrl>#d6</styleUrl><Point><coordinates>139.7707,35.6655,0</coordinates></Point></Placemark>
<Placemark><name>D6.5 Hop-on hop-off bus: Tokyo Tower</name><description><![CDATA[Listed highlight (bus passes by; tower entry not included).<br><a href="https://www.google.com/maps/search/?api=1&query=Tokyo%20Tower">Open in Google Maps</a>]]></description><styleUrl>#d6</styleUrl><Point><coordinates>139.7454,35.6586,0</coordinates></Point></Placemark>
<Placemark><name>D6.6 teamLab Planets TOKYO</name><description><![CDATA[Entry included. Barefoot, 1-2 hours.<br><a href="https://www.google.com/maps/search/?api=1&query=teamLab%20Planets%20TOKYO">Open in Google Maps</a>]]></description><styleUrl>#d6</styleUrl><Point><coordinates>139.7898,35.6491,0</coordinates></Point></Placemark>
<Placemark><name>D6 route</name><styleUrl>#d6</styleUrl><LineString><tessellate>1</tessellate><coordinates>139.7967,35.7148,0 139.8107,35.7101,0 139.765,35.6717,0 139.7707,35.6655,0 139.7454,35.6586,0 139.7898,35.6491,0</coordinates></LineString></Placemark>
</Folder>
<Folder><name>Day 7 - Tue 1 Dec - Mt Fuji &amp; Hakone tour</name>
<Placemark><name>D7.1 Mt Fuji 5th Station</name><description><![CDATA[Coach tour from Tokyo. If the road is closed beyond the 4th station, they go to Oshino Hakkai instead.<br><a href="https://www.google.com/maps/search/?api=1&query=Fuji%20Subaru%20Line%205th%20Station">Open in Google Maps</a>]]></description><styleUrl>#d7</styleUrl><Point><coordinates>138.733,35.395,0</coordinates></Point></Placemark>
<Placemark><name>D7.2 Oshino Hakkai (backup stop)</name><description><![CDATA[Only if the 5th Station is closed (likely in December weather).<br><a href="https://www.google.com/maps/search/?api=1&query=Oshino%20Hakkai">Open in Google Maps</a>]]></description><styleUrl>#d7</styleUrl><Point><coordinates>138.8327,35.4602,0</coordinates></Point></Placemark>
<Placemark><name>D7.3 Hakone Ropeway</name><description><![CDATA[Ropeway ticket included (PDF also mentions Komagatake ropeway as an alternative).<br><a href="https://www.google.com/maps/search/?api=1&query=Hakone%20Ropeway%20Owakudani">Open in Google Maps</a>]]></description><styleUrl>#d7</styleUrl><Point><coordinates>139.0196,35.244,0</coordinates></Point></Placemark>
<Placemark><name>D7.4 Lake Ashi cruise + floating torii</name><description><![CDATA[Cruise ticket included.<br><a href="https://www.google.com/maps/search/?api=1&query=Hakone%20Shrine%20torii">Open in Google Maps</a>]]></description><styleUrl>#d7</styleUrl><Point><coordinates>139.0249,35.205,0</coordinates></Point></Placemark>
<Placemark><name>D7.5 Gotemba Premium Outlets</name><description><![CDATA[Shopping stop, then back to Tokyo.<br><a href="https://www.google.com/maps/search/?api=1&query=Gotemba%20Premium%20Outlets">Open in Google Maps</a>]]></description><styleUrl>#d7</styleUrl><Point><coordinates>138.967,35.3075,0</coordinates></Point></Placemark>
<Placemark><name>D7 route</name><styleUrl>#d7</styleUrl><LineString><tessellate>1</tessellate><coordinates>138.733,35.395,0 138.8327,35.4602,0 139.0196,35.244,0 139.0249,35.205,0 138.967,35.3075,0</coordinates></LineString></Placemark>
</Folder>
<Folder><name>Day 8 - Wed 2 Dec - Tokyo DisneySea</name>
<Placemark><name>D8.1 Tokyo DisneySea</name><description><![CDATA[1-day ticket included. Getting there is on you (~30-40 min by train).<br><a href="https://www.google.com/maps/search/?api=1&query=Tokyo%20DisneySea">Open in Google Maps</a>]]></description><styleUrl>#d8</styleUrl><Point><coordinates>139.8851,35.6267,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Day 9 - Thu 3 Dec - Fly home</name>
<Placemark><name>D9.1 Narita Airport T2 (NRT)</name><description><![CDATA[Private car transfer from hotel included. CX527 NRT 14:25 -> HKG 18:55, CX601 HKG 21:05 -> HYD 00:50 (4 Dec).<br><a href="https://www.google.com/maps/search/?api=1&query=Narita%20Airport%20Terminal%202">Open in Google Maps</a>]]></description><styleUrl>#d9</styleUrl><Point><coordinates>140.3929,35.772,0</coordinates></Point></Placemark>
</Folder>
